# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# Public origin of the web app (used for CORS-free cookie settings, links in emails)
APP_URL=http://localhost:5173
# SQLite database file (relative to server/)
DATABASE_FILE=data/one-day-hostels.db
# Secret used to sign OTP / reset codes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# Online payments (Cashfree) run in Firebase Cloud Functions; configure them with
# `firebase functions:secrets:set CASHFREE_APP_ID` / `CASHFREE_SECRET_KEY` (see functions/.env.example).

# Email (optional). When SMTP_HOST is empty, emails are written to the server log in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="One Day Hostels <no-reply@onedayhostels.in>"

# Seed admin account (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@onedayhostels.in
SEED_ADMIN_PASSWORD=Admin@12345

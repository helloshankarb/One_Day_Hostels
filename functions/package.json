{
  "name": "functions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-odh-test --only auth,firestore,functions,storage \"node --test --test-concurrency=1 test/emulator/*.test.ts\"",
    "seed": "node scripts/seed-emulator.ts",
    "cashfree:sandbox-check": "node scripts/cashfree-sandbox-check.ts",
    "cashfree:stub": "node scripts/cashfree-stub-server.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.9.1",
    "firebase": "^13.1.0",
    "typescript": "^5.9.3"
  }
}

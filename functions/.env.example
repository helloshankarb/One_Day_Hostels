# Cloud Functions parameters. Copy to functions/.env.<projectId> (e.g. .env.prod) for deployment.
# Non-secret values only. Secrets are stored in Google Secret Manager:
#   npx firebase functions:secrets:set CASHFREE_APP_ID --project prod
#   npx firebase functions:secrets:set CASHFREE_SECRET_KEY --project prod
# For local emulators put sandbox keys in functions/.secret.local (git-ignored):
#   CASHFREE_APP_ID=TEST...
#   CASHFREE_SECRET_KEY=cfsk_ma_test_...

# sandbox | production
CASHFREE_ENV=sandbox
# Public origin of the web app (Cashfree return URL)
APP_URL=https://your-domain.example
# Public HTTPS URL of the deployed cashfreeWebhook function (also configure it in the Cashfree dashboard)
PAYMENT_NOTIFY_URL=https://asia-south1-YOUR_PROJECT.cloudfunctions.net/cashfreeWebhook

# Local development against the Firebase Emulator Suite (no real credentials needed).
# "demo-" project IDs only work with emulators and never touch production.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-one-day-hostels.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-one-day-hostels
VITE_FIREBASE_STORAGE_BUCKET=demo-one-day-hostels.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
VITE_USE_EMULATORS=true

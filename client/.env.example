# Production web config: copy to client/.env.production and fill from
# Firebase Console → Project settings → Your apps → Web app. These values are public identifiers, not secrets.
# Never put service-account keys or Cashfree secrets in any VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
VITE_USE_EMULATORS=false
